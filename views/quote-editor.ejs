<script>
// A4 sayfa 210mm (≈794px). Dar ekranda yeniden dizmek yerine küçültüyoruz.
// transform değil zoom: sarmalayıcının yüksekliği de küçülsün.
(function olcekle() {
  var belge = document.querySelector('.document');
  var sarmal = document.querySelector('.doc-wrapper');
  if (!belge || !sarmal) return;
  var TAM = 210 * 96 / 25.4;
  var deneme = 0;

  function uygula() {
    var yer = sarmal.clientWidth - 20;
    if (yer <= 0) { if (deneme++ < 30) requestAnimationFrame(uygula); return; }
    deneme = 0;
    belge.style.setProperty('--olcek', Math.min(1, yer / TAM).toFixed(3));
  }

  uygula();
  addEventListener('load', uygula);
  if (window.ResizeObserver) new ResizeObserver(uygula).observe(sarmal);
  else addEventListener('resize', uygula);
})();
</script>
</body>
</html>
